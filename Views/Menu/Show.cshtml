@model List<Dish>

@section Banner {
    <div class="banner">Cooked fresh every day</div>
}

<h1>Menu for @ViewBag.Day</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Staff"))

{
    <a class="btn btn-primary mb-3"
       asp-controller="Menu"
       asp-action="New">Add a dish</a>
}

@if (Model.Count == 0)
{
    <p>No specials today. Come back tomorrow.</p>
}
else
{
    int spicy_count = 0;
    foreach (Dish each_dish in Model)
    {
        if (each_dish.IsSpicy)
        {
            spicy_count++;
        }
        <partial name="_DishCard" model="each_dish" />
    }
    <p>@Model.Count specials, @spicy_count spicy</p>
}

@{
    ViewData["Title"] = "Menu";
    var searchText = ViewBag.SearchText as string ?? "";
    var sortBy = ViewBag.SortBy as string ?? "name";
    bool onlySpicyBool = false;
    if (ViewBag.OnlySpicy != null)
    {
        bool.TryParse(ViewBag.OnlySpicy.ToString(), out onlySpicyBool);
    }
}

<div class="card mb-4 shadow-sm">
  <div class="card-body">
    <h5 class="card-title mb-3">Filter Menu</h5>

    <form method="get" class="row g-3 align-items-center">
      <div class="col-12 col-md-6">
        <div class="form-floating">
          <input name="search_text" id="search_text" value="@searchText" class="form-control" placeholder="Search dishes..." />
          <label for="search_text">Search dishes</label>
        </div>
      </div>

      <div class="col-auto">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="only_spicy" id="only_spicy" value="true" checked="@(onlySpicyBool ? "checked" : null)" />
          <label class="form-check-label" for="only_spicy">Spicy only</label>
        </div>
      </div>

      <div class="col-12 col-md-3">
        <label class="form-label visually-hidden" for="sort_by">Sort by</label>
        <select id="sort_by" name="sort_by" class="form-select" aria-label="Sort by">
          <option value="name" selected="@(sortBy == "name" ? "selected" : null)">A to Z</option>
          <option value="price" selected="@(sortBy == "price" ? "selected" : null)">Cheapest first</option>
        </select>
      </div>

      <div class="col-auto d-flex align-items-center">
        <button type="submit" class="btn btn-primary me-2">
          Apply
        </button>
        <a class="btn btn-outline-secondary" href="@Url.Action("Show", "Menu")">Reset</a>
      </div>
    </form>
  </div>
</div>
