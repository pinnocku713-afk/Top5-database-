@model Dish

<h1>Delete @Model.Name?</h1>
<p class="text-danger">This can't be undone.</p>

<form method="post" asp-controller="Menu"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger">
        Yes, delete it</button>
    <a asp-controller="Menu" asp-action="Show">
        No, keep it</a>
</form>